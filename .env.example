# ==== Server ====
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# ==== MongoDB ====
MONGODB_URI=mongodb://127.0.0.1:27017/ai-code-review

# ==== AI Provider ====
# Which provider the AI service layer should use. Starts with "ollama" for local/free dev.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=codellama

# ==== Auth ====
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
