{
  "info": {
    "name": "AI Code Review System",
    "description": "Manual API testing collection for the Review CRUD endpoints. Uses a collection variable `reviewId` that gets set automatically after Create, so Get/Delete don't need the ID pasted in by hand. NOTE (Phase 11+): Create Review now only needs `language` + `sourceCode` — score/summary/issues are generated by the AI provider. Create Review requires a running, reachable AI provider (e.g. Ollama) or it will correctly return 502.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Create Review",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Automatically save the new review's _id so the Get/Delete",
              "// requests below can reuse it without you copy-pasting it.",
              "const body = pm.response.json();",
              "if (body && body.data && body.data._id) {",
              "    pm.collectionVariables.set('reviewId', body.data._id);",
              "}",
              "",
              "// 201 means the AI provider is reachable and returned a usable",
              "// review. 502 means the AI provider (e.g. Ollama) isn't running —",
              "// that's a correctly-handled failure, not a broken test. If you",
              "// see 502 here, start your AI provider and re-run this request.",
              "pm.test('Status code is 201 (or 502 if AI provider is not running)', function () {",
              "    pm.expect([201, 502]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"javascript\",\n  \"sourceCode\": \"function add(a, b) { return a + b; }\"\n}"
        }
      }
    },
    {
      "name": "List Reviews",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response data is an array', function () {",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/reviews"
      }
    },
    {
      "name": "Get Review By Id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
      }
    },
    {
      "name": "Get Review By Id - Invalid Id (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/reviews/not-a-real-id"
      }
    },
    {
      "name": "Create Review - Missing Fields (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\"\n}"
        }
      }
    },
    {
      "name": "Delete Review",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
      }
    },
    {
      "name": "Get Review By Id - After Delete (expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
      }
    }
  ]
}
